# Shared by the application build and CI packaging; VERSION remains the only input.
if(NOT DEFINED MINECRAFTC_VERSION_FILE)
    set(MINECRAFTC_VERSION_FILE "${CMAKE_CURRENT_LIST_DIR}/../VERSION")
endif()
file(READ "${MINECRAFTC_VERSION_FILE}" MINECRAFTC_VERSION)
string(STRIP "${MINECRAFTC_VERSION}" MINECRAFTC_VERSION)
if(NOT MINECRAFTC_VERSION MATCHES
   "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-(alpha|beta|rc|release)(\\.([1-9][0-9]*))?$")
    message(FATAL_ERROR
        "VERSION must use X.Y.Z-alpha|beta|rc|release with optional .N for prereleases (for example 1.3.4-beta.2)")
endif()
set(MINECRAFTC_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(MINECRAFTC_VERSION_MINOR "${CMAKE_MATCH_2}")
set(MINECRAFTC_VERSION_PATCH "${CMAKE_MATCH_3}")
set(MINECRAFTC_VERSION_CHANNEL "${CMAKE_MATCH_4}")
set(MINECRAFTC_VERSION_ITERATION "${CMAKE_MATCH_6}")
set(MINECRAFTC_VERSION_CORE
    "${MINECRAFTC_VERSION_MAJOR}.${MINECRAFTC_VERSION_MINOR}.${MINECRAFTC_VERSION_PATCH}")
if(MINECRAFTC_VERSION_CHANNEL STREQUAL "release" AND
   NOT MINECRAFTC_VERSION_ITERATION STREQUAL "")
    message(FATAL_ERROR "Release versions cannot have a prerelease iteration")
endif()
if(MINECRAFTC_VERSION_ITERATION STREQUAL "")
    set(MINECRAFTC_VERSION_ITERATION 0)
elseif(MINECRAFTC_VERSION_ITERATION GREATER 999)
    message(FATAL_ERROR "Prerelease iteration must be between 1 and 999")
endif()
if(MINECRAFTC_VERSION_MAJOR GREATER 20 OR
   MINECRAFTC_VERSION_MINOR GREATER 99 OR MINECRAFTC_VERSION_PATCH GREATER 99)
    message(FATAL_ERROR "Version exceeds the supported mobile version-code range (major <= 20, minor/patch <= 99)")
endif()
set(MINECRAFTC_VERSION_PRERELEASE true)
if(MINECRAFTC_VERSION_CHANNEL STREQUAL "release")
    set(MINECRAFTC_VERSION_LABEL "Release")
    set(MINECRAFTC_VERSION_CHANNEL_NUMBER 4)
    set(MINECRAFTC_VERSION_PRERELEASE false)
elseif(MINECRAFTC_VERSION_CHANNEL STREQUAL "rc")
    set(MINECRAFTC_VERSION_LABEL "RC")
    set(MINECRAFTC_VERSION_CHANNEL_NUMBER 3)
elseif(MINECRAFTC_VERSION_CHANNEL STREQUAL "beta")
    set(MINECRAFTC_VERSION_LABEL "Beta")
    set(MINECRAFTC_VERSION_CHANNEL_NUMBER 2)
else()
    set(MINECRAFTC_VERSION_LABEL "Alpha")
    set(MINECRAFTC_VERSION_CHANNEL_NUMBER 1)
endif()
if(MINECRAFTC_VERSION_ITERATION GREATER 0)
    string(APPEND MINECRAFTC_VERSION_LABEL ".${MINECRAFTC_VERSION_ITERATION}")
endif()
set(MINECRAFTC_VERSION_DISPLAY "${MINECRAFTC_VERSION_LABEL}-${MINECRAFTC_VERSION_CORE}")
# Reserve 1000 slots per channel so iterations cannot overlap the next stage.
math(EXPR MINECRAFTC_VERSION_CODE
    "(${MINECRAFTC_VERSION_MAJOR} * 10000 + ${MINECRAFTC_VERSION_MINOR} * 100 + ${MINECRAFTC_VERSION_PATCH}) * 10000 + ${MINECRAFTC_VERSION_CHANNEL_NUMBER} * 1000 + ${MINECRAFTC_VERSION_ITERATION}")
if(MINECRAFTC_VERSION_CODE GREATER 2100000000)
    message(FATAL_ERROR "Version code exceeds Android's 2100000000 limit")
endif()
set(MINECRAFTC_RELEASE_TAG "v${MINECRAFTC_VERSION}")
