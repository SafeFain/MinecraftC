# Shared entry point for package-owned C++ sources. No engine linkage is needed.
get_filename_component(_MINECRAFTC_CONTENT_SDK "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(EXISTS "${_MINECRAFTC_CONTENT_SDK}/tools/content_package.py")
    set(_MINECRAFTC_CONTENT_TOOL "${_MINECRAFTC_CONTENT_SDK}/tools/content_package.py")
else()
    set(_MINECRAFTC_CONTENT_TOOL "${_MINECRAFTC_CONTENT_SDK}/../tools/content_package.py")
endif()

function(minecraftc_add_content_package target)
    cmake_parse_arguments(PACKAGE "" "ROOT;MODE" "" ${ARGN})
    if(NOT PACKAGE_MODE MATCHES "^(BUILTIN|MODULE)$" OR NOT IS_DIRECTORY "${PACKAGE_ROOT}")
        message(FATAL_ERROR "Content package requires ROOT and MODE BUILTIN or MODULE")
    endif()
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    get_filename_component(package_root "${PACKAGE_ROOT}" REALPATH)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${_MINECRAFTC_CONTENT_TOOL}"
        metadata "${package_root}" RESULT_VARIABLE result OUTPUT_VARIABLE package_id
        ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Invalid content package: ${error}")
    endif()
    file(GLOB_RECURSE code CONFIGURE_DEPENDS "${package_root}/code/*.cpp" "${package_root}/code/*.c")
    if(PACKAGE_MODE STREQUAL "MODULE")
        if(ANDROID OR IOS OR NOT code)
            message(FATAL_ERROR "External native packages require desktop and code sources")
        endif()
        add_library(${target} MODULE ${code})
        target_include_directories(${target} PRIVATE "${_MINECRAFTC_CONTENT_SDK}")
        target_compile_features(${target} PRIVATE cxx_std_17)
        set_target_properties(${target} PROPERTIES PREFIX "" OUTPUT_NAME "${package_id}")
        if(APPLE)
            set_target_properties(${target} PROPERTIES SUFFIX ".dylib")
        endif()
        file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/content-module-$<CONFIG>.txt"
            CONTENT "$<TARGET_FILE:${target}>")
        add_custom_target(content_package_module DEPENDS ${target})
        return()
    endif()
    set(stage "${CMAKE_BINARY_DIR}/content-assets/plugins/${package_id}")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${_MINECRAFTC_CONTENT_TOOL}"
        stage "${package_root}" --output "${stage}" --refresh
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot stage content package: ${error}")
    endif()
    file(GLOB_RECURSE inputs CONFIGURE_DEPENDS "${package_root}/*")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs} "${_MINECRAFTC_CONTENT_TOOL}")
    set(query nullptr)
    set(behavior "content-package-v1")
    if(code)
        # Statically linked code has no module file in the runtime resource tree.
        # Carry its build-input identity in the runtime descriptor so code-only
        # changes cannot silently retain save/LAN requirements.
        file(GLOB_RECURSE code_inputs CONFIGURE_DEPENDS "${package_root}/code/*")
        list(APPEND code_inputs "${package_root}/CMakeLists.txt")
        list(SORT code_inputs)
        set(code_identity "")
        foreach(input IN LISTS code_inputs)
            if(NOT IS_DIRECTORY "${input}" AND EXISTS "${input}")
                if(input MATCHES "\\.(c|cpp|h|hpp|hh|hxx|inl|inc|cmake|txt)$")
                    file(READ "${input}" source_text)
                    string(REPLACE "\r\n" "\n" source_text "${source_text}")
                    string(REPLACE "\r" "\n" source_text "${source_text}")
                    string(SHA256 digest "${source_text}")
                else()
                    file(SHA256 "${input}" digest)
                endif()
                file(RELATIVE_PATH relative "${package_root}" "${input}")
                string(APPEND code_identity "${relative}:${digest}\n")
            endif()
        endforeach()
        string(SHA256 code_identity "${code_identity}")
        set(behavior "content-package-v1:${code_identity}")
        add_library(${target} STATIC ${code})
        target_include_directories(${target} PRIVATE "${_MINECRAFTC_CONTENT_SDK}")
        target_compile_features(${target} PRIVATE cxx_std_17)
        string(MAKE_C_IDENTIFIER "mc_content_query_${target}" query)
        target_compile_definitions(${target} PRIVATE "MCPlugin_Query=${query}")
        set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
        set_property(GLOBAL APPEND PROPERTY MINECRAFTC_CONTENT_LIBRARIES ${target})
        set_property(GLOBAL APPEND_STRING PROPERTY MINECRAFTC_CONTENT_DECLARATIONS
            "extern \"C\" const MC_Plugin* ${query}(uint32_t);\n")
    endif()
    set_property(GLOBAL APPEND_STRING PROPERTY MINECRAFTC_CONTENT_ENTRIES
        "entries.push_back({\"${package_id}\",\"${package_id}\",\"${behavior}\",\"plugins/${package_id}\",false,false,${query},true,\"${stage}\",\"${CMAKE_SOURCE_DIR}/assets\"});\n")
    set_property(GLOBAL APPEND PROPERTY MINECRAFTC_CONTENT_ROOTS "${stage}")
endfunction()
