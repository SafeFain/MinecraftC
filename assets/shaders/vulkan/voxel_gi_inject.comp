#version 450
#extension GL_GOOGLE_include_directive : require
#include "voxel_gi_aux.glsl"
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(set=0,binding=0) uniform sampler3D albedoOpacity;
layout(set=0,binding=1) uniform sampler3D lightValidity;
layout(set=0,binding=2,rgba16f) uniform writeonly image3D irradiance;
layout(set=0,binding=3,std430) readonly buffer Auxiliary { GiAux cells[]; } auxiliary;
layout(push_constant) uniform InjectConstants {
    vec4 skyColorDaylight;
    vec4 blockColorWeather;
    vec4 directColorIntensity;
    vec4 lightDirection;
    ivec4 regionOffset;
    ivec4 regionExtent;
} inject;
void main(){
    ivec3 localVoxel=ivec3(gl_GlobalInvocationID);
    if(any(greaterThanEqual(localVoxel,inject.regionExtent.xyz)))return;
    ivec3 voxel=localVoxel+inject.regionOffset.xyz;
    ivec3 size=imageSize(irradiance);
    if(any(greaterThanEqual(voxel,size)))return;
    vec4 material=texelFetch(albedoOpacity,voxel,0);
    vec4 light=texelFetch(lightValidity,voxel,0);
    if(light.a<0.5){imageStore(irradiance,voxel,vec4(0,0,0,-1));return;}
    GiAux a=auxiliary.cells[voxel.x+size.x*(voxel.y+size.y*voxel.z)];
    vec3 direction=inject.lightDirection.xyz/max(length(inject.lightDirection.xyz),0.0001);
    float diffuse=0.0,exposed=0.0;
    for(int f=0;f<6;++f){
        float area=giExposure(a,f);
        diffuse+=area*max(dot(giFaceNormal(f),direction),0.0);
        exposed+=area;
    }
    diffuse/=max(exposed,1.0);
    // Atlas reflectance is already linear. Sky light approximates visibility;
    // it is not a directional shadow map. Colored emission is never multiplied by albedo.
    vec3 reflected=material.rgb*(inject.skyColorDaylight.rgb*light.r*0.72+
        inject.directColorIntensity.rgb*inject.directColorIntensity.a*diffuse*light.r*0.52+
        inject.blockColorWeather.rgb*light.g*0.20);
    imageStore(irradiance,voxel,vec4(reflected+giRgb(a.emission)*1.35,material.a));
}
