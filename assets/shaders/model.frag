#version 330 core
in vec2 vUV;in vec3 vNormal;in vec3 vWorldPosition;out vec4 FragColor;
uniform sampler2D uTexture;uniform int uUseTexture,uManualGamma;uniform vec4 uBaseColor;uniform float uAlphaCutoff;uniform vec3 uAmbientColor,uDirectColor,uLightDirection,uCameraPosition,uFogColor;uniform float uFogStart,uFogEnd;
void main(){vec4 base=(uUseTexture!=0?texture(uTexture,vUV):vec4(1.0))*uBaseColor;if(base.a<uAlphaCutoff)discard;float diffuse=max(dot(normalize(vNormal),normalize(uLightDirection)),0.0);vec3 color=base.rgb*(uAmbientColor+uDirectColor*diffuse);float distanceToCamera=length(vWorldPosition-uCameraPosition);float fog=clamp((distanceToCamera-uFogStart)/max(uFogEnd-uFogStart,.001),0.0,1.0);color=mix(color,uFogColor,fog);if(uManualGamma!=0)color=pow(max(color,vec3(0.0)),vec3(1.0/2.2));FragColor=vec4(color,base.a);}
